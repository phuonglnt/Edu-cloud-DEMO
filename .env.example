OPENAI_API_KEY=
ASSISTANT_API_KEY=
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=
MOODLE_ADMIN_EMAIL=
LLM_API_KEY=            # Clé API Groq, utilisée par stats-api

# Ces quatre variables remplacent, dans docker-stack-stats.yml, les adresses du serveur.
#   LOCAL   : elles sont actives, laissez-les telles quelles.
#   SERVEUR : commentez les quatre lignes, les valeurs par défaut du stack s'appliquent.
SWARM_DB_HOST=host.docker.internal
SWARM_DB_PORT=5434
SWARM_ASSISTANT_URL=http://host.docker.internal:3001
SWARM_HTTPS_PROXY=
STATS_ADMIN_PASSWORD=   # Mot de passe du tableau de bord (utilisateur admin)
